{
  "id": "cow/swap",
  "card": {
    "sell-token": {
      "kind": "contract",
      "registryKind": "token"
    },
    "buy-token": {
      "kind": "contract",
      "registryKind": "token"
    },
    "sell-amount": {
      "kind": "amount",
      "of": "sell-token"
    },
    "min-buy": {
      "kind": "amount",
      "of": "buy-token",
      "floor": {
        "sells": "sell-amount"
      }
    }
  },
  "calls": [
    {
      "to": {
        "contract": "gpv2-settlement"
      },
      "value": {
        "const": "0"
      },
      "function": "setPreSignature(bytes orderUid, bool signed)",
      "args": {
        "orderUid": {
          "packed": [
            {
              "name": "digest",
              "type": "bytes32",
              "rule": {
                "eip712": {
                  "domain": {
                    "name": "Gnosis Protocol",
                    "version": "v2",
                    "verifyingContract": "gpv2-settlement"
                  },
                  "type": "Order(address sellToken,address buyToken,address receiver,uint256 sellAmount,uint256 buyAmount,uint32 validTo,bytes32 appData,uint256 feeAmount,string kind,bool partiallyFillable,string sellTokenBalance,string buyTokenBalance)",
                  "lookup": "https://api.cow.fi/mainnet/api/v1/orders/{arg}",
                  "fields": {
                    "sellToken": {
                      "card": "sell-token"
                    },
                    "buyToken": {
                      "card": "buy-token"
                    },
                    "receiver": {
                      "safe": true
                    },
                    "sellAmount": {
                      "card": "sell-amount"
                    },
                    "buyAmount": {
                      "atLeast": "card.min-buy"
                    },
                    "validTo": {
                      "withinSeconds": 604800
                    },
                    "appData": {
                      "free": {
                        "en": "The hash of the app's JSON note on the order (app code, slippage, an optional partner fee or hooks). The settlement contract never reads it and enforces the signed tokens, amounts and receiver whatever it says; a partner fee comes out of the price above the card's minimum, and a hook runs from CoW's trampoline contract, not as the Safe.",
                        "zh-TW": "app 附在訂單上的 JSON 備註的 hash（app 代碼、滑價、可選的合作方手續費或 hooks）。結算合約從不讀它，不管它寫什麼，都照簽好的代幣、數量和收款人執行；合作方手續費從高於卡片最低值的價格中扣，hook 由 CoW 的 trampoline 合約執行，不是以 Safe 的身分執行。"
                      }
                    },
                    "feeAmount": {
                      "const": "0"
                    },
                    "kind": {
                      "const": "sell"
                    },
                    "partiallyFillable": {
                      "const": "false"
                    },
                    "sellTokenBalance": {
                      "const": "erc20"
                    },
                    "buyTokenBalance": {
                      "const": "erc20"
                    }
                  }
                }
              }
            },
            {
              "name": "owner",
              "type": "address",
              "rule": {
                "safe": true
              }
            },
            {
              "name": "validTo",
              "type": "uint32",
              "rule": {
                "equals": "calls[0].args.orderUid.packed.digest.eip712.fields.validTo"
              }
            }
          ]
        },
        "signed": {
          "const": "true"
        }
      }
    }
  ],
  "effects": {
    "gives": [],
    "gets": []
  }
}
