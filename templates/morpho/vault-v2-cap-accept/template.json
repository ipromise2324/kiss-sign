{
  "id": "morpho/vault-v2-cap-accept",
  "card": {
    "vault": {
      "kind": "contract",
      "registryKind": "vault",
      "defillama": "morpho-blue"
    },
    "market": {
      "kind": "market"
    },
    "absolute-cap": {
      "kind": "amount",
      "of": "vault.asset",
      "max": {
        "value": "340282366920938463463374607431768211455",
        "why": {
          "en": "2^128-1 is the largest absolute cap Vault V2 can store; a larger value reverts, so the card refuses it.",
          "zh-TW": "2^128-1 是 Vault V2 能存的最大絕對上限；更大的值會 revert，所以卡片不收。"
        }
      }
    }
  },
