{
  "id": "morpho/vault-deposit",
  "card": {
    "vault": {
      "kind": "contract",
      "registryKind": "vault",
      "defillama": "morpho-blue"
    },
    "amount": {
      "kind": "amount",
      "of": "vault.asset"
    },
    "min-shares": {
      "kind": "amount",
      "of": "vault",
      "computed": {
        "read": {
          "to": {
            "card": "vault"
          },
          "function": "previewDeposit(uint256 assets) returns (uint256 shares)",
          "args": {
            "assets": {
              "card": "amount"
            }
          }
        },
        "bound": "floor",
        "default": {
          "bps": 3,
          "source": "https://github.com/morpho-org/sdks/blob/56f1ed62827a7aab39d979c0143d1fbf970c37ca/packages/blue-sdk/src/constants.ts"
        },
        "margin": {
          "bps": 7,
          "why": {
            "en": "The app prices the deposit again when it builds the transaction, and the share price keeps rising (about 0.37% in 30 days), so the default alone can make it a MISMATCH",
            "zh-TW": "app 建立交易時會重新計價，而份額價格持續上漲（30 天約 0.37%），只用預設值可能讓 app 自己的交易 MISMATCH"
          }
        }
      }
    }
  },
  "calls": [
    {
      "to": {
        "card": "vault.asset"
      },
      "value": {
        "const": "0"
      },
      "function": "approve(address spender, uint256 value)",
      "args": {
        "spender": {
          "contract": "vault-bundles-v1"
        },
        "value": {
          "card": "amount"
        }
      }
    },
    {
      "to": {
        "contract": "vault-bundles-v1"
      },
      "value": {
        "const": "0"
      },
      "function": "vaultBundlesV1Deposit(address vault, uint256 assets, uint256 maxSharePriceE27, (uint8 kind, bytes data) assetPermit, uint256 referralFeePct, address referralFeeRecipient, uint256 deadline)",
      "args": {
        "vault": {
          "card": "vault"
        },
        "assets": {
          "card": "amount"
        },
        "maxSharePriceE27": {
          "maxSharePrice": {
            "assets": "card.amount",
            "shares": "card.min-shares",
            "scale": 27
          }
        },
        "assetPermit": {
          "fields": {
            "kind": {
              "const": "0"
            },
            "data": {
              "const": "0x"
            }
          }
        },
        "referralFeePct": {
          "const": "0"
        },
        "referralFeeRecipient": {
          "const": "0x0000000000000000000000000000000000000000"
        },
        "deadline": {
          "withinSeconds": 7200
        }
      },
      "trailer": {
        "maxBytes": 12,
        "why": {
          "en": "The Morpho app appends up to 12 bytes to vaultBundlesV1Deposit, a timestamp and one or two origin tags, in the 34 Safe transactions of this shape studied; the contract reads only its seven arguments.",
          "zh-TW": "Morpho app 會在 vaultBundlesV1Deposit 後面附上最多 12 bytes（時間戳記和一或兩個來源標記），研究過的 34 筆這種形狀的 Safe 交易都有；合約只讀它的七個引數。"
        }
      }
    }
  ],
  "effects": {
    "gives": [
      {
        "token": "card.vault.asset",
        "amount": "card.amount"
      }
    ],
    "gets": [
      {
        "token": "card.vault",
        "amount": {
          "atLeast": "card.min-shares"
        }
      }
    ]
  }
}
