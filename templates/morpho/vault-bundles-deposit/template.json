              }
            }
          }
        },
        "referralFeePct": {
          "const": "0"
        },
        "referralFeeRecipient": {
          "const": "0x0000000000000000000000000000000000000000"
        },
        "deadline": {
          "free": "a time after which the call reverts; it limits when the deposit can run, not what it does"
        }
      },
      "trailer": {
        "maxBytes": 12,
        "why": "the Morpho app appends a 4-byte timestamp and one or two 4-byte origin tags (morpho-org/sdks, addTransactionMetadata); vaultBundlesV1Deposit reads only its arguments"
      }
    }
  ],
  "effects": {
    "gives": [
