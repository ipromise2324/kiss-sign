{
  "id": "morpho/vault-v2-adapter-cap-accept",
  "card": {
    "vault": {
      "kind": "contract",
      "registryKind": "vault",
      "defillama": "morpho-blue"
    },
    "absolute-cap": {
      "kind": "amount",
      "of": "vault.asset",
      "max": {
        "value": "340282366920938463463374607431768211455",
        "why": "Vault V2 stores an absolute cap in 128 bits (increaseAbsoluteCap, newAbsoluteCap.toUint128()), so 2^128-1 is the largest cap it holds; curators set it for an adapter they cap only by its relative cap."
      }
    },
    "relative-cap": {
      "kind": "percent"
    }
  },
