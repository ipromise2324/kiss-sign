{
  "id": "uniswap/swap",
  "card": {
    "sell-token": {
      "kind": "contract",
      "registryKind": "token"
    },
    "buy-token": {
      "kind": "contract",
      "registryKind": "token"
    },
    "sell-amount": {
      "kind": "amount",
      "of": "sell-token"
    },
    "min-buy": {
      "kind": "amount",
      "of": "buy-token"
    }
  },
  "calls": [
    {
      "to": {
        "contract": "universal-router-2.1.2"
      },
      "value": {
        "const": "0"
      },
      "function": "execute(bytes commands, bytes[] inputs, uint256 deadline)",
      "args": {
        "commands": {
          "const": "0x10"
        },
        "inputs": {
          "items": [
            {
              "encoded": {
                "as": "V4_SWAP(bytes actions, bytes[] params)",
                "args": {
                  "actions": {
                    "const": "0x070b0e"
                  },
                  "params": {
                    "items": [
                      {
                        "encoded": {
                          "as": "SWAP_EXACT_IN((address currencyIn, (address intermediateCurrency, uint24 fee, int24 tickSpacing, address hooks, bytes hookData)[] path, uint256[] minHopPriceX36, uint128 amountIn, uint128 amountOutMinimum) params)",
                          "args": {
                            "params": {
                              "fields": {
                                "currencyIn": {
                                  "card": "sell-token"
                                },
                                "path": {
                                  "items": [
                                    {
                                      "fields": {
                                        "intermediateCurrency": {
                                          "card": "buy-token"
                                        },
                                        "fee": {
                                          "free": {
                                            "route": "The fee of the Uniswap v4 pool the app's router picks for the two tokens. A pool is the two tokens, this fee, the tick spacing and the hooks, here none; another fee names another pool of the same two tokens, or none, which reverts. Anyone can open a v4 pool, so the price is guarded by the card's minimum, not by the pool: the Safe gets at least min-buy or the swap reverts."
                                          }
                                        },
                                        "tickSpacing": {
                                          "free": {
                                            "route": "The tick spacing of the same pool, which the app picks with the fee; another value names another pool or none, as for the fee."
                                          }
                                        },
                                        "hooks": {
                                          "const": "0x0000000000000000000000000000000000000000"
                                        },
                                        "hookData": {
                                          "const": "0x"
                                        }
                                      }
                                    }
                                  ]
                                },
                                "minHopPriceX36": {
                                  "free": "Per-pool price floors the app may add, one per hop or none. The router only reverts when a hop's price falls below one, so any value can only stop the swap; the card's minimum is checked on amountOutMinimum whatever they say."
                                },
                                "amountIn": {
                                  "card": "sell-amount"
                                },
                                "amountOutMinimum": {
                                  "atLeast": "card.min-buy"
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "encoded": {
                          "as": "SETTLE(address currency, uint256 amount, bool payerIsUser)",
                          "args": {
                            "currency": {
                              "card": "sell-token"
                            },
                            "amount": {
                              "const": "0"
                            },
                            "payerIsUser": {
                              "const": "true"
                            }
                          }
                        }
                      },
                      {
                        "encoded": {
                          "as": "TAKE(address currency, address recipient, uint256 amount)",
                          "args": {
                            "currency": {
                              "card": "buy-token"
                            },
                            "recipient": {
                              "safe": true
                            },
                            "amount": {
                              "const": "0"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        "deadline": {
          "free": "The time after which the router refuses the swap, which the app sets when it builds the transaction. A later deadline only lets the transaction run later; the Safe still gives exactly the card's amount and gets at least the card's minimum."
        }
      },
      "trailer": {
        "maxBytes": 46,
        "why": "The Uniswap app appends a tag that starts with the ASCII bytes unix and holds a timestamp: 22 bytes on a call of its own and 46 inside a MultiSend in the Safe transactions studied. execute reads only its three arguments, as the router's registry entry says (ignoresTrailer)."
      }
    }
  ],
  "effects": {
    "gives": [
      {
        "token": "card.sell-token",
        "amount": "card.sell-amount"
      }
    ],
    "gets": [
      {
        "token": "card.buy-token",
        "amount": {
          "atLeast": "card.min-buy"
        }
      }
    ]
  }
}
