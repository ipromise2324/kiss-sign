{
  "id": "compound/supply",
  "instanceField": "market",
  "card": {
    "market": { "kind": "contract", "registryKind": "lending", "defillama": "compound-v3" },
    "amount": { "kind": "amount", "of": "market.baseToken" }
  },
  "calls": [
    {
      "to": { "card": "market.baseToken" },
      "value": { "const": "0" },
      "function": "approve(address spender, uint256 value)",
      "args": {
        "spender": { "card": "market" },
        "value": { "card": "amount" }
      }
    },
    {
      "to": { "card": "market" },
      "value": { "const": "0" },
      "function": "supply(address asset, uint256 amount)",
      "args": {
        "asset": { "card": "market.baseToken" },
        "amount": { "card": "amount" }
      }
    }
  ],
  "effects": {
    "gives": [{ "token": "card.market.baseToken", "amount": "card.amount" }],
    "gets": [
      {
        "token": "card.market",
        "amount": "card.amount",
        "tolerance": {
          "less": 2,
          "why": {
            "en": "In 22 supplies studied (2 Safes, 20 EOAs), the sender's cUSDCv3 balance rose by the amount less 1 unit in 17 and less 2 units in 5, never more: Comet rounds the supply down.",
            "zh-TW": "研究的 22 筆存入（2 個 Safe、20 個 EOA）中，送出者的 cUSDCv3 餘額增加的是金額少 1 單位的有 17 筆、少 2 單位的有 5 筆，沒有更多：Comet 存入時向下取整。"
          }
        }
      }
    ]
  }
}
