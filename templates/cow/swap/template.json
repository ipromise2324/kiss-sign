{
  "id": "cow/swap",
  "card": {
    "sell-token": {
      "kind": "contract",
      "registryKind": "token",
      "names": [
        "usdc",
        "usdt"
      ]
    },
    "buy-token": {
      "kind": "contract",
      "registryKind": "token",
      "names": [
        "usdc",
        "usdt"
      ]
    },
    "sell-amount": {
      "kind": "amount",
      "of": "sell-token"
    },
    "min-buy": {
      "kind": "amount",
      "of": "buy-token",
      "floor": {
        "sells": "sell-amount"
      }
    }
  },
  "calls": [
    {
      "to": {
        "contract": "gpv2-settlement"
      },
      "value": {
        "const": "0"
      },
      "function": "setPreSignature(bytes orderUid, bool signed)",
      "args": {
        "orderUid": {
          "packed": [
            {
              "name": "orderDigest",
              "type": "bytes32",
              "rule": {
                "eip712": {
                  "domain": {
                    "name": "Gnosis Protocol",
                    "version": "v2",
                    "verifyingContract": "gpv2-settlement"
                  },
                  "type": "Order(address sellToken,address buyToken,address receiver,uint256 sellAmount,uint256 buyAmount,uint32 validTo,bytes32 appData,uint256 feeAmount,string kind,bool partiallyFillable,string sellTokenBalance,string buyTokenBalance)",
                  "fields": {
                    "sellToken": {
                      "card": "sell-token"
                    },
                    "buyToken": {
                      "card": "buy-token"
                    },
                    "receiver": {
                      "safe": true
                    },
                    "sellAmount": {
                      "card": "sell-amount"
                    },
                    "buyAmount": {
                      "atLeast": "card.min-buy"
                    },
                    "validTo": {
                      "withinSeconds": 43200
                    },
                    "appData": {
                      "free": {
                        "en": "The hash of the app's order metadata: app name, slippage, a partner fee, optional hooks. The settlement contract never reads it; the order still sells exactly the card amount to the Safe for at least the card minimum.",
                        "zh-TW": "app 附在訂單上的資料的雜湊：app 名稱、滑價、合作方手續費、可選的 hooks。結算合約從不讀它；訂單仍然是剛好賣出卡片上的數量、收款人是 Safe、至少拿到卡片上的最低值。"
                      }
                    },
                    "feeAmount": {
                      "const": "0"
                    },
                    "kind": {
                      "const": "sell"
                    },
                    "partiallyFillable": {
                      "const": "false"
                    },
                    "sellTokenBalance": {
                      "const": "erc20"
                    },
                    "buyTokenBalance": {
                      "const": "erc20"
                    }
                  },
                  "lookup": "https://api.cow.fi/mainnet/api/v1/orders/{arg}"
                }
              }
            },
            {
              "name": "owner",
              "type": "address",
              "rule": {
                "safe": true
              }
            },
            {
              "name": "validTo",
              "type": "uint32",
              "rule": {
                "withinSeconds": 43200
              }
            }
          ]
        },
        "signed": {
          "const": "true"
        }
      }
    }
  ],
  "effects": {
    "gives": [],
    "gets": []
  }
}
